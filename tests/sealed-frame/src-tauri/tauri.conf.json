{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PM sealed-frame regression",
  "version": "0.0.0",
  "identifier": "org.itsatlas.pm.sealedframe",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "PM sealed-frame regression",
        "width": 900,
        "height": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src pmmod://localhost http://pmmod.localhost;"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../../src-tauri/icons/32x32.png",
      "../../../src-tauri/icons/128x128.png",
      "../../../src-tauri/icons/128x128@2x.png",
      "../../../src-tauri/icons/icon.icns",
      "../../../src-tauri/icons/icon.ico"
    ]
  }
}
