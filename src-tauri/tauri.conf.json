{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PM",
  "version": "2.92.24-alpha",
  "identifier": "org.itsatlas.pm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/fetch-python.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PM (Alpha)",
        "width": 1100,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none';",
      "devCsp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 ws://localhost:1421; object-src 'none'; base-uri 'self'; frame-src 'none';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "Entitlements.plist"
    },
    "resources": {
      "../sidecar/pm_sidecar.py": "sidecar/pm_sidecar.py",
      "../sidecar/requirements.txt": "sidecar/requirements.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyMDhGQjU1MzM3NUYzNUQKUldSZDgzVXpWZnNJc3QwcWN1dFQyY3NLWWd3d2F4bkE3UFRHdlAwcnc2bWdGZlEvLy9sZTAzSkwK",
      "endpoints": [
        "https://github.com/Admin-Atlas/Personal-Manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
